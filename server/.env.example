# Copy to .env (git-ignored) and fill in. Never commit real values.

# Twilio Console > Account info > Auth Token. Used only to verify that webhook requests come from Twilio.
TWILIO_AUTH_TOKEN=

# The exact public HTTPS URL Twilio calls: your tunnel URL followed by /whatsapp
# e.g. https://abc123.ngrok-free.app/whatsapp  (it changes each time the tunnel restarts; update it in Twilio too)
PUBLIC_WEBHOOK_URL=

# Optional
PORT=3000
# The YolIA website linked in replies
YOLIA_SITE_URL=
# Minutes an idle conversation is remembered
SESSION_MINUTES=360
